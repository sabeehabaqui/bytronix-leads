[Unit]
Description=Keep private outreach drafts waiting in Gmail (never sends)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/bytronix-leads
ExecStartPre=/usr/bin/timeout 300 /bin/sh -c 'until getent hosts imap.gmail.com >/dev/null; do sleep 5; done'
ExecStart=%h/bytronix-leads/.venv/bin/python leads.py --keep-drafts 5
TimeoutStartSec=30min
StandardOutput=append:%h/bytronix-leads/leads.log
StandardError=append:%h/bytronix-leads/leads.log
